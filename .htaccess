# ═══════════════════════════════════════════════════════════════
# GERVAIS PARTNERS - CONFIGURATION SERVEUR APACHE / LWS (.htaccess)
# Sécurité HTTPS, Redirections Canoniques, Caching & Performance
# ═══════════════════════════════════════════════════════════════

# Activation de la réécriture d'URL
RewriteEngine On

# 1. FORCER LE HTTPS STRICT & REDIRECTION CANONIQUE
# Redirige http:// vers https://
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirige design--*.netlify.app ou sous-domaines test vers le domaine officiel
RewriteCond %{HTTP_HOST} ^design--gervais-partenairs\.netlify\.app$ [NC]
RewriteRule ^(.*)$ https://gervaispartners.com/$1 [L,R=301]

# 2. EN-TÊTES DE SÉCURITÉ HTTP DE HAUT NIVEAU
<IfModule mod_headers.c>
    # Protection contre le détournement de clic (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Protection contre le MIME-sniffing
    Header set X-Content-Type-Options "nosniff"

    # Activation de la protection XSS du navigateur
    Header set X-XSS-Protection "1; mode=block"

    # Politique de référent sécurisée
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Forcer HTTPS strict pour 1 an avec sous-domaines (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 3. COMPRESSION GZIP / DEFLATE POUR UN CHARGEMENT ULTRA-RAPIDE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. GESTION DU CACHE NAVIGATEUR (EXPIRES & CACHE-CONTROL)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML : Vérification continue (1 heure)
    ExpiresByType text/html "access plus 1 hour"

    # CSS & JavaScript : 1 semaine (ou contrôle par version ?v=)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"

    # Images & Favicons : 1 an (immutables)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Polices web : 1 an
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 5. PROTECTION DES FICHIERS CACHÉS
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Interdire l'affichage de l'index des répertoires
Options -Indexes
